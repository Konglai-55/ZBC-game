# 开发和生产环境都必须设置以下三项，程序不提供默认管理员密码。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# 图片对象存储（S3 兼容）
OBJECT_STORAGE_ENDPOINT=https://cn-nb1.rains3.com
OBJECT_STORAGE_REGION=cn-nb1
OBJECT_STORAGE_BUCKET=gameimg
OBJECT_STORAGE_ACCESS_KEY_ID=replace-with-access-key-id
OBJECT_STORAGE_SECRET_ACCESS_KEY=replace-with-secret-access-key
